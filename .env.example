NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (gratis). Kosongkan untuk mematikan captcha di lokal.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shopee Affiliate Open API (opsional): isi otomatis produk Shopee + "Use my affiliate link" untuk admin.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Ringkasan mingguan lewat email (opsional): Vercel Cron + Resend (free tier).
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
